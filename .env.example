# Os valores abaixo são exemplos.
# O instalador (instalar.ps1 ou instalar.sh) cria o .env com segredos aleatórios.
# Se copiar este arquivo para .env na mão, troque POSTGRES_PASSWORD e JWT_SECRET.

# Senha do banco PostgreSQL
POSTGRES_PASSWORD=escola
# Segredo usado para assinar os logins (JWT)
JWT_SECRET=troque-este-segredo-de-exemplo
# Nome da conta de administrador criada na primeira subida
ADMIN_NOME=Administrador
# E-mail da conta de administrador criada na primeira subida
ADMIN_EMAIL=admin@escola.local
# Senha inicial do administrador (padrão: admin1234); troque em Meu perfil depois do primeiro acesso
ADMIN_SENHA=admin1234
# true carrega os dados de demonstração (fictícios, só para teste)
SEED_DEMO=false
# Porta do site no computador
WEB_PORT=8090
# Porta da API no computador
API_PORT=3090
# Porta do banco no computador (publicada só em 127.0.0.1)
DB_PORT=5432
