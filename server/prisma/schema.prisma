// CONTRATO DE DADOS do sistema escolar. Escrito pelo main.
// Nenhum gerador altera este arquivo. Se algo faltar, pergunte ao @main na sala.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

// TI tem o mesmo acesso do ADMIN (o servidor trata TI como ADMIN nas permissões).
enum Perfil {
  ADMIN
  TI
  SECRETARIA
  PROFESSOR
  ALUNO
}

enum NivelEnsino {
  FUNDAMENTAL_1
  FUNDAMENTAL_2
  MEDIO
  TECNICO
  GRADUACAO
  ESPECIALIZACAO
  MESTRADO
  DOUTORADO
}

// SERIADO: aluno cursa todas as disciplinas da série (fundamental, médio, técnico).
// CREDITOS: aluno se inscreve disciplina a disciplina (graduação e pós).
enum RegimeCurso {
  SERIADO
  CREDITOS
}

enum Titulacao {
  GRADUADO
  ESPECIALISTA
  MESTRE
  DOUTOR
}

enum TipoPeriodo {
  ANUAL
  SEMESTRAL
}

enum StatusMatricula {
  ATIVA
  TRANCADA
  CONCLUIDA
  CANCELADA
}

enum StatusInscricao {
  CURSANDO
  APROVADO
  REPROVADO_NOTA
  REPROVADO_FALTA
  TRANCADO
}

enum TipoEvento {
  LETIVO
  FERIADO
  PROVA
  EVENTO
  RECESSO
}

enum StatusProjeto {
  EM_ELABORACAO
  QUALIFICADO
  APROVADO
  REPROVADO
}

enum TipoBanca {
  QUALIFICACAO
  DEFESA
}

enum ResultadoBanca {
  PENDENTE
  APROVADO
  APROVADO_COM_RESSALVAS
  REPROVADO
}

enum PapelBanca {
  PRESIDENTE
  INTERNO
  EXTERNO
  SUPLENTE
}

enum StatusMensalidade {
  ABERTA
  PAGA
  ATRASADA
  CANCELADA
}

enum StatusEmprestimo {
  ATIVO
  DEVOLVIDO
}

enum PublicoComunicado {
  TODOS
  ALUNOS
  PROFESSORES
  TURMA
  CURSO
}

// ---------- Pessoas ----------

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil
  ativo     Boolean  @default(true)
  cpf       String?
  telefone  String?
  foto      String? // endereço http(s) ou data URL (imagem reduzida enviada pelo usuário)
  criadoEm  DateTime @default(now())

  aluno       Aluno?
  professor   Professor?
  emprestimos Emprestimo[]
  comunicados Comunicado[]
  leituras    ComunicadoLeitura[]
}

model Aluno {
  id                  Int      @id @default(autoincrement())
  usuarioId           Int      @unique
  usuario             Usuario  @relation(fields: [usuarioId], references: [id])
  ra                  String   @unique // registro acadêmico, ex.: "202600001"
  dataNascimento      DateTime
  endereco            String?
  responsavelNome     String?
  responsavelTelefone String?
  responsavelEmail    String?

  matriculas Matricula[]
}

model Professor {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @unique
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  registro  String    @unique // ex.: "P0001"
  titulacao Titulacao
  area      String?

  turmas         Turma[]
  orientacoes    ProjetoPesquisa[] @relation("Orientador")
  coorientacoes  ProjetoPesquisa[] @relation("Coorientador")
  participacoes  BancaMembro[]
}

// ---------- Estrutura acadêmica ----------

model Curso {
  id                Int         @id @default(autoincrement())
  nome              String
  codigo            String      @unique
  nivel             NivelEnsino
  regime            RegimeCurso
  duracaoPeriodos   Int // nº de séries (seriado) ou semestres (créditos)
  cargaHorariaTotal Int
  mensalidade       Float       @default(0) // valor em reais
  ativo             Boolean     @default(true)

  disciplinas Disciplina[]
  matriculas  Matricula[]
  comunicados Comunicado[]
}

model Disciplina {
  id              Int     @id @default(autoincrement())
  cursoId         Int
  curso           Curso   @relation(fields: [cursoId], references: [id])
  nome            String
  codigo          String  @unique
  cargaHoraria    Int
  creditos        Int     @default(0)
  periodoSugerido Int     @default(1) // série ou semestre em que é cursada
  obrigatoria     Boolean @default(true)

  preRequisitos  Disciplina[] @relation("PreRequisitos")
  preRequisitoDe Disciplina[] @relation("PreRequisitos")
  turmas         Turma[]
}

model PeriodoLetivo {
  id     Int         @id @default(autoincrement())
  nome   String      @unique // ex.: "2026" ou "2026.2"
  ano    Int
  tipo   TipoPeriodo
  inicio DateTime
  fim    DateTime
  ativo  Boolean     @default(true)

  turmas     Turma[]
  matriculas Matricula[]
  eventos    EventoCalendario[]
}

// Turma = oferta de UMA disciplina em UM período letivo com UM professor.
// No regime SERIADO, as turmas da mesma classe compartilham o campo "grupo" (ex.: "6A").
model Turma {
  id              Int           @id @default(autoincrement())
  codigo          String
  disciplinaId    Int
  disciplina      Disciplina    @relation(fields: [disciplinaId], references: [id])
  periodoLetivoId Int
  periodoLetivo   PeriodoLetivo @relation(fields: [periodoLetivoId], references: [id])
  professorId     Int
  professor       Professor     @relation(fields: [professorId], references: [id])
  grupo           String?
  vagas           Int           @default(40)
  sala            String?

  inscricoes  Inscricao[]
  avaliacoes  Avaliacao[]
  aulas       Aula[]
  horarios    HorarioAula[]
  comunicados Comunicado[]

  @@unique([codigo, periodoLetivoId])
}

// ---------- Matrícula e vida acadêmica ----------

model Matricula {
  id                Int             @id @default(autoincrement())
  alunoId           Int
  aluno             Aluno           @relation(fields: [alunoId], references: [id])
  cursoId           Int
  curso             Curso           @relation(fields: [cursoId], references: [id])
  periodoIngressoId Int
  periodoIngresso   PeriodoLetivo   @relation(fields: [periodoIngressoId], references: [id])
  dataMatricula     DateTime        @default(now())
  status            StatusMatricula @default(ATIVA)
  serieAtual        Int             @default(1)

  inscricoes   Inscricao[]
  mensalidades Mensalidade[]
  bolsas       Bolsa[]
  projeto      ProjetoPesquisa?

  @@unique([alunoId, cursoId])
}

model Inscricao {
  id          Int             @id @default(autoincrement())
  matriculaId Int
  matricula   Matricula       @relation(fields: [matriculaId], references: [id])
  turmaId     Int
  turma       Turma           @relation(fields: [turmaId], references: [id])
  status      StatusInscricao @default(CURSANDO)
  notaFinal   Float? // 0 a 10
  frequencia  Float? // 0 a 100 (percentual de presença)

  notas     Nota[]
  presencas Presenca[]

  @@unique([matriculaId, turmaId])
}

// ---------- Notas e frequência ----------

model Avaliacao {
  id         Int      @id @default(autoincrement())
  turmaId    Int
  turma      Turma    @relation(fields: [turmaId], references: [id])
  nome       String
  peso       Float    @default(1)
  data       DateTime
  notaMaxima Float    @default(10)

  notas Nota[]
}

model Nota {
  id          Int       @id @default(autoincrement())
  avaliacaoId Int
  avaliacao   Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  inscricaoId Int
  inscricao   Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  valor       Float

  @@unique([avaliacaoId, inscricaoId])
}

model Aula {
  id       Int      @id @default(autoincrement())
  turmaId  Int
  turma    Turma    @relation(fields: [turmaId], references: [id])
  data     DateTime
  conteudo String?

  presencas Presenca[]
}

model Presenca {
  id          Int       @id @default(autoincrement())
  aulaId      Int
  aula        Aula      @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  inscricaoId Int
  inscricao   Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  presente    Boolean

  @@unique([aulaId, inscricaoId])
}

// ---------- Horários e calendário ----------

model HorarioAula {
  id         Int     @id @default(autoincrement())
  turmaId    Int
  turma      Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  diaSemana  Int // 1 = segunda ... 6 = sábado, 7 = domingo
  horaInicio String // "HH:MM"
  horaFim    String // "HH:MM"
  sala       String?
}

model EventoCalendario {
  id              Int            @id @default(autoincrement())
  titulo          String
  descricao       String?
  inicio          DateTime
  fim             DateTime
  tipo            TipoEvento
  periodoLetivoId Int?
  periodoLetivo   PeriodoLetivo? @relation(fields: [periodoLetivoId], references: [id])
}

// ---------- Pós-graduação ----------

model ProjetoPesquisa {
  id             Int           @id @default(autoincrement())
  matriculaId    Int           @unique
  matricula      Matricula     @relation(fields: [matriculaId], references: [id])
  orientadorId   Int
  orientador     Professor     @relation("Orientador", fields: [orientadorId], references: [id])
  coorientadorId Int?
  coorientador   Professor?    @relation("Coorientador", fields: [coorientadorId], references: [id])
  titulo         String
  resumo         String
  linhaPesquisa  String?
  status         StatusProjeto @default(EM_ELABORACAO)
  criadoEm       DateTime      @default(now())

  bancas Banca[]
}

model Banca {
  id        Int             @id @default(autoincrement())
  projetoId Int
  projeto   ProjetoPesquisa @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  tipo      TipoBanca
  data      DateTime
  local     String?
  resultado ResultadoBanca  @default(PENDENTE)
  parecer   String?

  membros BancaMembro[]
}

model BancaMembro {
  id          Int        @id @default(autoincrement())
  bancaId     Int
  banca       Banca      @relation(fields: [bancaId], references: [id], onDelete: Cascade)
  professorId Int? // membro interno
  professor   Professor? @relation(fields: [professorId], references: [id])
  nomeExterno String? // membro externo (sem cadastro)
  instituicao String?
  papel       PapelBanca
}

// ---------- Financeiro ----------

model Mensalidade {
  id             Int               @id @default(autoincrement())
  matriculaId    Int
  matricula      Matricula         @relation(fields: [matriculaId], references: [id])
  competencia    String // "AAAA-MM"
  vencimento     DateTime
  valor          Float // valor cheio em reais
  desconto       Float             @default(0) // em reais
  status         StatusMensalidade @default(ABERTA)
  pagoEm         DateTime?
  formaPagamento String?

  @@unique([matriculaId, competencia])
}

model Bolsa {
  id          Int       @id @default(autoincrement())
  matriculaId Int
  matricula   Matricula @relation(fields: [matriculaId], references: [id])
  nome        String
  percentual  Float // 0 a 100
  inicio      DateTime
  fim         DateTime?
  ativa       Boolean   @default(true)
}

// ---------- Biblioteca ----------

model Livro {
  id          Int     @id @default(autoincrement())
  titulo      String
  autor       String
  isbn        String?
  editora     String?
  ano         Int?
  categoria   String?
  exemplares  Int     @default(1)
  disponiveis Int     @default(1)
  capa        String? // imagem da capa: endereço http(s) ou data URL (imagem reduzida enviada pelo usuário)

  emprestimos Emprestimo[]
}

model Emprestimo {
  id               Int              @id @default(autoincrement())
  livroId          Int
  livro            Livro            @relation(fields: [livroId], references: [id])
  usuarioId        Int
  usuario          Usuario          @relation(fields: [usuarioId], references: [id])
  retiradoEm       DateTime         @default(now())
  devolucaoPrevista DateTime
  devolvidoEm      DateTime?
  status           StatusEmprestimo @default(ATIVO)
}

// ---------- Comunicados ----------

model Comunicado {
  id          Int               @id @default(autoincrement())
  titulo      String
  corpo       String
  autorId     Int
  autor       Usuario           @relation(fields: [autorId], references: [id])
  publicadoEm DateTime          @default(now())
  publico     PublicoComunicado
  turmaId     Int?
  turma       Turma?            @relation(fields: [turmaId], references: [id])
  cursoId     Int?
  curso       Curso?            @relation(fields: [cursoId], references: [id])

  leituras ComunicadoLeitura[]
}

// ---------- Medalhas ----------

// Só as medalhas concedidas à mão ficam no banco.
// As automáticas são calculadas na hora a partir dos dados (notas, frequência, biblioteca...).
model MedalhaConcedida {
  id             Int      @id @default(autoincrement())
  usuarioId      Int // quem recebeu
  concedidaPorId Int // quem concedeu
  titulo         String
  descricao      String?
  icone          String   @default("medalha") // nome de ícone do cliente
  cor            String   @default("azul") // azul, roxo, verde ou laranja
  pontos         Int      @default(20)
  criadoEm       DateTime @default(now())

  @@index([usuarioId])
}

// ---------- Suporte (chamados) ----------

enum CategoriaChamado {
  TECNICO // atendido por ADMIN e TI
  SECRETARIA // atendido por SECRETARIA (e ADMIN, TI)
  FINANCEIRO // atendido por SECRETARIA (e ADMIN, TI)
  ACADEMICO // atendido pelo professor da turma escolhida (e ADMIN, TI)
}

enum PrioridadeChamado {
  BAIXA
  NORMAL
  ALTA
}

enum StatusChamado {
  ABERTO // aguardando a equipe
  EM_ATENDIMENTO // a equipe respondeu por último
  AGUARDANDO_USUARIO // a equipe pediu informação
  RESOLVIDO
  FECHADO
}

model Chamado {
  id                   Int               @id @default(autoincrement())
  autorId              Int
  categoria            CategoriaChamado
  turmaId              Int? // obrigatório quando a categoria é ACADEMICO
  assunto              String
  prioridade           PrioridadeChamado @default(NORMAL)
  status               StatusChamado     @default(ABERTO)
  responsavelId        Int? // usuário da equipe que assumiu
  avaliacao            Int? // 1 a 5, dada pelo autor depois de resolvido
  avaliacaoComentario  String?
  criadoEm             DateTime          @default(now())
  atualizadoEm         DateTime          @default(now())
  ultimaMensagemEm     DateTime          @default(now())
  ultimaMensagemEquipe Boolean           @default(false) // a última mensagem foi da equipe?
  lidoPeloAutorEm      DateTime?
  lidoPelaEquipeEm     DateTime?

  mensagens ChamadoMensagem[]

  @@index([autorId])
  @@index([status, categoria])
}

model ChamadoMensagem {
  id        Int      @id @default(autoincrement())
  chamadoId Int
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autorId   Int
  daEquipe  Boolean  @default(false)
  texto     String
  anexo     String? // data URL de imagem reduzida (opcional)
  criadoEm  DateTime @default(now())

  @@index([chamadoId])
}

// ---------- Fórum ----------

model ForumComunidade {
  id          Int      @id @default(autoincrement())
  nome        String
  slug        String   @unique // minúsculas, números e hífen
  descricao   String?
  cor         String   @default("azul") // azul, roxo, verde ou laranja
  criadoPorId Int
  criadoEm    DateTime @default(now())

  publicacoes ForumPublicacao[]
}

model ForumPublicacao {
  id           Int             @id @default(autoincrement())
  comunidadeId Int
  comunidade   ForumComunidade @relation(fields: [comunidadeId], references: [id], onDelete: Cascade)
  autorId      Int
  titulo       String
  corpo        String
  imagem       String? // data URL de imagem reduzida (opcional)
  fixada       Boolean         @default(false)
  fechada      Boolean         @default(false) // não aceita novos comentários
  removida     Boolean         @default(false)
  pontos       Int             @default(0) // soma dos votos
  comentarios  Int             @default(0) // quantidade de comentários não removidos
  criadoEm     DateTime        @default(now())
  editadoEm    DateTime?

  respostas ForumComentario[]
  votos     ForumVoto[]

  @@index([comunidadeId, criadoEm])
}

model ForumComentario {
  id           Int             @id @default(autoincrement())
  publicacaoId Int
  publicacao   ForumPublicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  autorId      Int
  paiId        Int? // comentário respondido (árvore)
  corpo        String
  removido     Boolean         @default(false)
  pontos       Int             @default(0)
  criadoEm     DateTime        @default(now())
  editadoEm    DateTime?

  votos ForumVoto[]

  @@index([publicacaoId])
}

model ForumVoto {
  id           Int              @id @default(autoincrement())
  usuarioId    Int
  publicacaoId Int?
  publicacao   ForumPublicacao? @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  comentarioId Int?
  comentario   ForumComentario? @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  valor        Int // +1 ou -1

  @@unique([usuarioId, publicacaoId])
  @@unique([usuarioId, comentarioId])
}

// ---------- Log de atividades ----------

// Um registro por atividade na plataforma. Visível só para ADMIN e TI.
// Não guarda corpo de requisição nem senha. Registros com mais de 90 dias são apagados.
model LogAtividade {
  id          Int      @id @default(autoincrement())
  criadoEm    DateTime @default(now())
  usuarioId   Int? // sem relação: o log sobrevive à exclusão do usuário
  usuarioNome String?
  perfil      String? // perfil real no momento: ADMIN, TI, SECRETARIA, PROFESSOR ou ALUNO
  tipo        String // LOGIN, FALHA_LOGIN, SAIDA, TELA, CONSULTA, CRIACAO, ALTERACAO, EXCLUSAO
  modulo      String // ex.: alunos, turmas, financeiro, sessao
  descricao   String // frase curta em português
  metodo      String? // GET, POST, PUT, DELETE
  caminho     String? // caminho da API ou da tela, sem query string
  status      Int? // código HTTP da resposta
  duracaoMs   Int?
  ip          String?
  navegador   String?

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
  @@index([tipo, criadoEm])
}

model ComunicadoLeitura {
  comunicadoId Int
  comunicado   Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  usuarioId    Int
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  lidoEm       DateTime   @default(now())

  @@id([comunicadoId, usuarioId])
}

// ===== Configurações da plataforma (linha única, id = 1) =====

model ConfiguracaoPlataforma {
  id            Int      @id @default(1)
  nome          String   @default("Sistema Escolar")
  slogan        String   @default("Construindo um futuro melhor.")
  logo          String? // data URL (jpeg, png ou webp) ou endereço http(s); null = logo padrão
  corPrimaria   String   @default("#2563eb")
  corSecundaria String   @default("#1d4ed8")
  enderecoSite  String? // endereço público do site, usado nos links dos e-mails

  smtpServidor      String?
  smtpPorta         Int      @default(587)
  smtpSeguro        Boolean  @default(false) // true = TLS direto (porta 465)
  smtpUsuario       String?
  smtpSenhaCifrada  String? // AES-256-GCM; nunca sai pela API
  emailRemetente    String?
  emailNomeRemetente String?
  emailAtivo        Boolean  @default(false)

  emailRecuperacao Boolean @default(true)
  emailBoasVindas  Boolean @default(true)
  emailComunicados Boolean @default(true)
  emailSuporte     Boolean @default(true)

  // Cópia de segurança automática do banco
  backupAutomatico Boolean @default(true)
  backupHora       Int     @default(3) // hora do dia (0 a 23), no relógio do servidor
  backupManter     Int     @default(7) // quantas cópias automáticas guardar

  atualizadoEm DateTime @updatedAt
}

enum TipoTokenSenha {
  RECUPERACAO
  BOAS_VINDAS
}

// Token de uso único para criar ou redefinir a senha por e-mail (só o hash fica no banco).
model TokenSenha {
  id        Int            @id @default(autoincrement())
  usuarioId Int
  tokenHash String         @unique
  tipo      TipoTokenSenha
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime       @default(now())

  @@index([usuarioId])
}

enum StatusEmail {
  ENVIADO
  FALHOU
}

// Histórico dos e-mails enviados (sem o corpo), para o administrador conferir.
model EmailEnviado {
  id       Int         @id @default(autoincrement())
  para     String
  assunto  String
  tipo     String // TESTE, RECUPERACAO, BOAS_VINDAS, COMUNICADO, SUPORTE
  status   StatusEmail
  erro     String?
  criadoEm DateTime    @default(now())

  @@index([criadoEm])
}

// ===== Chat privado =====

enum TipoConversa {
  INDIVIDUAL
  GRUPO
}

model ChatConversa {
  id              Int          @id @default(autoincrement())
  tipo            TipoConversa
  nome            String? // só em grupo
  foto            String? // só em grupo
  chaveIndividual String?      @unique // "menorId:maiorId", só em conversa individual
  criadoPorId     Int
  criadaEm        DateTime     @default(now())
  atualizadaEm    DateTime     @default(now()) // instante da última mensagem ou mudança

  participantes ChatParticipante[]
  mensagens     ChatMensagem[]

  @@index([atualizadaEm])
}

model ChatParticipante {
  id              Int          @id @default(autoincrement())
  conversaId      Int
  conversa        ChatConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  usuarioId       Int
  admin           Boolean      @default(false) // administrador do grupo
  entrouEm        DateTime     @default(now())
  saiuEm          DateTime?
  ultimaEntregaEm DateTime? // até quando as mensagens chegaram ao aparelho da pessoa
  ultimaLeituraEm DateTime? // até quando a pessoa leu

  @@unique([conversaId, usuarioId])
  @@index([usuarioId])
}

model ChatMensagem {
  id          Int          @id @default(autoincrement())
  conversaId  Int
  conversa    ChatConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autorId     Int
  texto       String       @default("")
  imagem      String? // data URL reduzida
  respostaAId Int? // mensagem citada
  sistema     Boolean      @default(false) // aviso do sistema (entrou, saiu, grupo criado)
  criadaEm    DateTime     @default(now())
  apagadaEm   DateTime?

  @@index([conversaId, criadaEm])
}

// ===== Central de notificações =====

// Aviso para um usuário, mostrado no sino. O link é o caminho dentro do portal, sem o prefixo
// do perfil (por exemplo "/comunicados" ou "/forum/p/12"); o cliente acrescenta /admin, /professor ou /aluno.
model Notificacao {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  tipo      String // COMUNICADO, SUPORTE, FORUM, NOTA, FINANCEIRO, MEDALHA, BIBLIOTECA, SISTEMA
  titulo    String
  texto     String    @default("")
  link      String?
  chave     String? // evita repetir o mesmo aviso (única por usuário quando preenchida)
  criadaEm  DateTime  @default(now())
  lidaEm    DateTime?

  @@unique([usuarioId, chave])
  @@index([usuarioId, criadaEm])
}

// ===== Arquivos enviados (leva 6) =====

// O conteúdo fica em disco (volume dados_arquivos); aqui ficam os dados e o vínculo.
// Um arquivo nasce sem vínculo (contexto nulo) e é ligado pela rota de quem o usa.
model Arquivo {
  id           Int      @id @default(autoincrement())
  nomeOriginal String
  tipo         String // tipo MIME conferido pelo servidor
  tamanho      Int // bytes
  caminho      String   @unique // nome do arquivo em disco (gerado pelo servidor)
  donoId       Int // usuário que enviou
  contexto     String? // MATERIAL, TAREFA, ENTREGA
  contextoId   Int?
  criadoEm     DateTime @default(now())

  @@index([contexto, contextoId])
  @@index([donoId, contexto])
}

// ===== Sala de aula =====

model MaterialAula {
  id          Int      @id @default(autoincrement())
  turmaId     Int
  titulo      String
  descricao   String   @default("")
  topico      String   @default("") // agrupador livre: "Unidade 1", "Aula 3"...
  link        String? // endereço http(s) externo (vídeo, site)
  criadoPorId Int
  criadoEm    DateTime @default(now())

  @@index([turmaId])
}

model Tarefa {
  id           Int      @id @default(autoincrement())
  turmaId      Int
  titulo       String
  enunciado    String   @default("")
  prazo        DateTime
  notaMaxima   Float    @default(10)
  aceitaAtraso Boolean  @default(true)
  avaliacaoId  Int? // quando ligada a uma avaliação do diário, a nota corrigida vai para lá
  criadoPorId  Int
  criadaEm     DateTime @default(now())

  entregas TarefaEntrega[]

  @@index([turmaId])
}

model TarefaEntrega {
  id             Int       @id @default(autoincrement())
  tarefaId       Int
  tarefa         Tarefa    @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  inscricaoId    Int
  texto          String    @default("")
  entregueEm     DateTime  @default(now())
  atrasada       Boolean   @default(false)
  nota           Float?
  comentario     String    @default("")
  corrigidaEm    DateTime?
  corrigidaPorId Int?

  @@unique([tarefaId, inscricaoId])
}

// Item do plano de aula da turma. Quando a aula acontece, o item é ligado à aula do diário.
model PlanoAula {
  id           Int       @id @default(autoincrement())
  turmaId      Int
  ordem        Int
  tema         String
  objetivos    String    @default("")
  dataPrevista DateTime?
  aulaId       Int? // aula do diário em que o tema foi dado
  criadoEm     DateTime  @default(now())

  @@index([turmaId, ordem])
}

enum TipoQuestao {
  OBJETIVA
  VERDADEIRO_FALSO
  DISSERTATIVA
}

model Prova {
  id              Int      @id @default(autoincrement())
  turmaId         Int
  titulo          String
  instrucoes      String   @default("")
  abreEm          DateTime
  fechaEm         DateTime
  duracaoMin      Int      @default(60)
  embaralhar      Boolean  @default(false)
  notaMaxima      Float    @default(10)
  mostrarGabarito Boolean  @default(false) // depois de fechada, o aluno vê as respostas certas
  publicada       Boolean  @default(false)
  avaliacaoId     Int? // quando ligada a uma avaliação do diário, a nota final vai para lá
  criadoPorId     Int
  criadaEm        DateTime @default(now())

  questoes   ProvaQuestao[]
  tentativas ProvaTentativa[]

  @@index([turmaId])
}

model ProvaQuestao {
  id           Int         @id @default(autoincrement())
  provaId      Int
  prova        Prova       @relation(fields: [provaId], references: [id], onDelete: Cascade)
  ordem        Int
  tipo         TipoQuestao
  enunciado    String
  alternativas Json        @default("[]") // lista de textos (OBJETIVA); vazio nos outros tipos
  correta      Int? // índice da alternativa certa (OBJETIVA) ou 1 = verdadeiro, 0 = falso
  pontos       Float       @default(1)

  respostas ProvaResposta[]

  @@index([provaId, ordem])
}

model ProvaTentativa {
  id           Int       @id @default(autoincrement())
  provaId      Int
  prova        Prova     @relation(fields: [provaId], references: [id], onDelete: Cascade)
  inscricaoId  Int
  iniciadaEm   DateTime  @default(now())
  expiraEm     DateTime // o menor entre início + duração e o fechamento da prova
  enviadaEm    DateTime?
  notaObjetiva Float? // soma dos pontos das questões corrigidas sozinhas
  notaFinal    Float? // em escala de 0 a notaMaxima, depois de corrigidas as dissertativas
  corrigida    Boolean   @default(false)

  respostas ProvaResposta[]

  @@unique([provaId, inscricaoId])
}

model ProvaResposta {
  id          Int            @id @default(autoincrement())
  tentativaId Int
  tentativa   ProvaTentativa @relation(fields: [tentativaId], references: [id], onDelete: Cascade)
  questaoId   Int
  questao     ProvaQuestao   @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  alternativa Int? // índice escolhido (OBJETIVA) ou 1/0 (VERDADEIRO_FALSO)
  texto       String         @default("")
  pontos      Float? // nulo enquanto a dissertativa não foi corrigida
  comentario  String         @default("")

  @@unique([tentativaId, questaoId])
}

// Chamada por QR code: o professor abre para uma aula e o código muda a cada poucos segundos.
model ChamadaQr {
  id       Int       @id @default(autoincrement())
  aulaId   Int       @unique
  segredo  String // base do código rotativo; nunca sai pela API
  abertaEm DateTime  @default(now())
  fechaEm  DateTime
  fechada  Boolean   @default(false)
}
